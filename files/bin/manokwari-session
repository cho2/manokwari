#! /bin/sh
# manokwari-session -- X11 session entry point (see files/xsessions/manokwari.desktop).
#
# Milestone 3: no more gnome-session, no more mutter. Manokwari pairs with
# Openbox as its window manager (EWMH-compliant, so the libwnck-based
# taskbar works correctly) plus picom for compositing (PanelDesktop's clock
# widget uses an RGBA transparent window, which needs a compositor to
# render correctly rather than showing solid black).
#
# picom and manokwari are started directly here rather than through
# Openbox's own autostart.sh mechanism -- deliberately, to avoid owning/
# conflicting with a system file the openbox package might also ship.
# Openbox itself is exec'd last and becomes this session's foreground
# process: the session ends when Openbox exits, including via the Logout
# button in Manokwari's own menu (which runs "openbox --exit" --
# see PanelSessionManager.logout() in src/panel-session-manager.vala).

L=`dbus-send --system --print-reply --type=method_call --dest=org.freedesktop.Accounts /org/freedesktop/Accounts/User1000 org.freedesktop.DBus.Properties.Get string:'org.freedesktop.Accounts.User' string:'Language' 2>/dev/null|tail -1|awk '{print $3}'|sed -e s/\"//g`

if [ "x$L" != "x" ];then
   LANG=$L
else
  LANG=XX
fi

FINAL_L=`locale -a | grep $LANG\$`
FALLBACK=`locale -a | grep C.UTF-8 | tail -1`

if [ "x$FINAL_L" != "x" ];then
    LANG=$FINAL_L
    LC_ALL=$FINAL_L
else
    LANG=$FALLBACK
    LC_ALL=$FALLBACK
fi
export LANG LC_ALL

picom &
manokwari &
exec openbox
